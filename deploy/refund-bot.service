[Unit]
Description=Refund Bot (Dabba demo)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/wip_demo
ExecStart=/home/ubuntu/wip_demo/.venv/bin/uvicorn app.server:app --host 0.0.0.0 --port 8787 --workers 1
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
